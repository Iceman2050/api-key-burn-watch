# Copy to .env (NEVER commit .env) — or export these in your shell / cron env.
# Only OpenAI is actively polled; Anthropic and Google have no public
# usage/billing API for API keys, so those keys are recorded as unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional: webhook URL that receives a JSON payload when an alert fires.
BURN_WATCH_WEBHOOK_URL=
